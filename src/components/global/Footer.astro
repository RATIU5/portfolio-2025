---
import Button from "@ui/elements/Button.astro";

export type Props = {
	class?: string;
};

const { class: className } = Astro.props;

const date = new Date();
const copyrightYears =
	date.getFullYear() === 2025 ? "2025" : `2025 - ${date.getFullYear()}`;
---

<footer class={className} role="contentinfo">
	<div class="px-space py-16 md:py-20">
		<p class="text-lg w-full text-center">
			© {copyrightYears} RATIU5. All rights reserved.
		</p>
	</div>
</footer>
