---
import { generateSketchLine } from "@utils/sketchLine";

interface Props {
	stroke?: string;
	roughness?: number;
	strokeWidth?: number;
	height?: number;
	seed?: number;
	class?: string;
}

const {
	stroke = "#2c2c2c",
	roughness = 2,
	strokeWidth = 2,
	height = 8,
	seed = 12345,
	class: className = "",
} = Astro.props;

const svg = generateSketchLine(seed, 1000, height, {
	stroke,
	strokeWidth,
	roughness,
	bowing: 0.5,
});
---

<div
	class:list={["sketch-divider block w-full", className]}
	style={`height: ${height}px`}
	set:html={svg}
/>

<style is:global>
.sketch-divider svg {
	width: 100%;
	height: 100%;
}
</style>
