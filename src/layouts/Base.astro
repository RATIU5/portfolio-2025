---
import { Font } from "astro:assets";
import SketchLinks from "@components/global/SketchLinks.astro";
import SketchButtons from "@components/global/SketchButtons.astro";
import DitherImages from "@components/global/DitherImages.astro";

import "@styles/global.css";

export type Props = {
	class?: string;
};

const { class: className } = Astro.props;
---

<html lang="en">
	<head>
		<meta charset="utf-8">
		<link rel="icon" type="image/svg+xml" href="/favicon.svg">
		<meta name="viewport" content="width=device-width">
		<meta name="generator" content={Astro.generator}>
		<Font cssVariable="--ftg" preload />
		<Font cssVariable="--gyg" preload />
		<Font cssVariable="--cm" preload />
		<Font cssVariable="--typrighter" preload />
		<slot name="head" />
	</head>
	<body class:list={{ "min-h-screen": true, [className!]: Boolean(className) }}>
		<slot />
		<SketchLinks />
		<SketchButtons />
		<DitherImages />
	</body>
</html>
