---
import { StudioCMSRenderer } from "studiocms:renderer";
import { SDKCoreJs, runSDK } from "studiocms:sdk";
import Page from "../layouts/Page.astro";
import Main from "../components/ui/sections/Main.astro";
import ProseMain from "../components/ui/sections/ProseMain.astro";

let { slug } = Astro.params;

if (!slug) {
	slug = "index";
}

const data = await runSDK(SDKCoreJs.GET.page.bySlug(slug));

if (!data) {
	return new Response(null, { status: 404 });
}

const { title, description, heroImage, parentFolder } = data;

let isArticle = false;
if (parentFolder) {
	const parentFolderData = await runSDK(SDKCoreJs.GET.folder(parentFolder));
	if (parentFolderData?.name.toLowerCase() === "article") {
		isArticle = true;
	}
}
---

<Page>
	<Fragment slot="head">
		<meta property="og:type" content="article">
		<meta property="og:title" content={title}>
		<meta property="og:description" content={description}>
		{heroImage && <meta property="og:image" content={heroImage} />}
	</Fragment>
	<ProseMain {isArticle}>
		<StudioCMSRenderer data={data} />
	</ProseMain>
</Page>
