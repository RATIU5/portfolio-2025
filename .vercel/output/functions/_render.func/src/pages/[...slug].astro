---
import { StudioCMSRenderer } from "studiocms:renderer";
import { SDKCoreJs, runSDK } from "studiocms:sdk";
import Page from "../layouts/Page.astro";
import ProseMain from "../components/ui/sections/ProseMain.astro";
import SEO from "../components/global/SEO.astro";

let { slug } = Astro.params;

if (!slug) {
	slug = "index";
}

const data = await runSDK(SDKCoreJs.GET.page.bySlug(slug));

if (!data) {
	return Astro.redirect("/404");
}

const { title, description, heroImage, parentFolder, publishedAt } = data;

let isArticle = false;
if (parentFolder) {
	const parentFolderData = await runSDK(SDKCoreJs.GET.folder(parentFolder));
	if (parentFolderData?.name.toLowerCase() === "article") {
		isArticle = true;
	}
}
---

<Page>
	<Fragment slot="head">
		<SEO
			title={title}
			description={description}
			image={heroImage}
			type={isArticle ? "article" : "website"}
			publishedAt={isArticle ? new Date(publishedAt).toISOString() : undefined}
		/>
	</Fragment>
	<ProseMain {isArticle}>
		<StudioCMSRenderer data={data} />
	</ProseMain>
</Page>
